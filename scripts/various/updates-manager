#!/usr/bin/env bash

# Author: Barret E (2020-26) <https://github.com/archusXIV/dotfiles>
#
# Yet Another Updates Manager Script for Arch Linux based systems.
# We need sudo privileges without password prompt for this script to work.
# This script is also designed to work alongside polybar as it updates
# my checkupdates module before and after processing system upgrade.

: "${XDG_RUNTIME_DIR:-/run/user/1000}"
arch_list="$XDG_RUNTIME_DIR/archlinux.list"
aur_list="$XDG_RUNTIME_DIR/aur.list"
arch_aur_list="$XDG_RUNTIME_DIR/combined.list"
mirr_dir="/etc/pacman.d"
arch_mirr="$mirr_dir/archlinux-mirrorlist"
arch_bckp="$arch_mirr"_bckp
cachyos_mirr="$mirr_dir/cachyos-mirrorlist"
chaotic_mirr="$mirr_dir/chaotic-mirrorlist"

# Colors
N=$'\e[0m'
R=$'\e[0;31m'
G=$'\e[0;32m'

declare -a deps=(
    "checkupdates"
    "pacman"
    "rankmirrors"
    "reflector"
    "wmctrl"
    "yay"
)

_Cleanup() {
    # This will stop the while loop in the _CheckUpdates function.
    rm -f {"$arch_list","$aur_list","$arch_aur_list"} >/dev/null 2>&1
    exit "${1:-0}"
}

_Error() {
    printf '%s\n' " ${R}ERROR: $1${N}" >&2
    exit "${2:-1}"
}

_PolybarHook() {
    if pgrep -x polybar &>/dev/null; then
        pid=$(pgrep --full "$(wmctrl -m | awk '/Name/{print $2}')"-bar-2)
        polybar-msg -p "$pid" action "#updates-ipc.hook.0" >/dev/null 2>&1
        notify-send -p "Available update(s): $(wc -l < "$arch_aur_list")"
    else
        notify-send "Available update(s): $(wc -l < "$arch_aur_list")"
    fi
}

_rateMirrors() {

    local repo="$1"
    case $repo in
        official)
            sudo reflector \
                --country "$(curl -s https://ipinfo.io/country)" \
                --latest 10 \
                --age 24 \
                --protocol https \
                --sort rate \
                --save "$arch_mirr" >/dev/null 2>&1
        ;;
        third-party)
            ! command -v rate-mirrors &>/dev/null && return 1
            __rateThirdPartyMirrors() {
                rate-mirrors \
                --disable-comments \
                --entry-country="$(curl -s https://ipinfo.io/country)" \
                --exclude-countries=US,CA,CN,NZ,RU "$1"
            }
            [[ -f $cachyos_mirr ]] && {
                __rateThirdPartyMirrors cachyos | sudo tee "$cachyos_mirr"
                # shellcheck disable=SC2016
                sed 's/\$arch/\$arch_v4/g' "$cachyos_mirr" \
                | sudo tee /etc/pacman.d/cachyos-v4-mirrorlist
            }
            [[ -f $chaotic_mirr ]] && {
                __rateThirdPartyMirrors chaotic-aur | sudo tee "$chaotic_mirr"
            }
        ;;
        *)
            printf '%s\n' " ${R}$repo does not exist${N}"
            sleep 2
            return 1
        ;;
    esac

}

_CheckUpdates() {

    for dep in "${deps[@]}"; do
        command -v "$dep" >/dev/null 2>&1 || \
        _Error " ${R}Missing dependency: ${dep}${N}" 127
    done
    # Set trap for cleanup
    trap '_Cleanup' SIGTERM

    while [[ -f $arch_aur_list ]]; do
        # Checking the network
        if [[ -z $(ping -c 1 archlinux.org 2>/dev/null) ]]; then
            notify-send -u critical 'archlinux.org unreachable'
            _Cleanup 1
        fi

        sudo cp -f "$arch_mirr" "$arch_bckp"

        _rateMirrors official

        timeout 5 checkupdates > "$arch_list"
        timeout 5 yay -Qua > "$aur_list"
        cat "$arch_list" "$aur_list" > "$arch_aur_list"

        # remove some weird characters possibly written by yay,
        sed -i -e '/^::/d' -e '/^\s*$/d' -e 's/^\s\+//' "$arch_aur_list"
        # and duplicates from combined.list
        awk -i inplace '!seen[$0]++' "$arch_aur_list"
        _PolybarHook
        sleep 3592s
    done &

}

_YesNoPrompt() {
    # stolen from budRich
    # with this we can't answer anything else than yes or no.
    local screenprompt key default options status

    default=y
    options=yn

    [[ $1 =~ -([${options}]) ]] \
        && default="${BASH_REMATCH[1]}" && shift

    screenprompt="$* [${default^^}/${options/$default/}]"

    # Is this function called from a terminal?
    if [[ -t 2 ]]; then
        >&2 echo "$screenprompt"

        while :; do
            read -rsn 1
            key="${REPLY:-$default}"
            [[ $key =~ [${options}] ]] || continue
            break
        done
    else
        key="$default"
    fi

    [[ ${key,,} = n ]] && status=1

    return "${status:-0}"
}

_Snapshot() {

    local older_snapshot_index older_snapshot_name
    # will remove the first snapshot & create a new one.
    if command -v timeshift >/dev/null; then
        # awk '/^0/{print $3}' will match the first snapshot over three.
        older_snapshot_index=$(sudo timeshift --list | awk '/^0/{print $1}')
        older_snapshot_name=$(sudo timeshift --list | awk '/^0/{print $3}')
        # checking '0' as a string
        if [[ $older_snapshot_index == '0' ]]; then
            sudo timeshift --delete --snapshot "$older_snapshot_name"
            sudo timeshift --create --skip-grub --comment "Before updates"
        else
            sudo timeshift --create --skip-grub --comment "Before updates"
        fi
    else
        notify-send -u critical " ${G}Timeshift is not installed...${N}"
        sleep 2
    fi

}

_AskforSnapshot() {
    _YesNoPrompt " ${R}Do you want to create a snapshot?: ${N}" || {
        return 1
    }
    return 0
}

_Installation() {
    sudo cp -f "$arch_mirr" "$arch_bckp"
    echo "${G}Ranking mirrolist...be patient${N}"
    rankmirrors -n 10 "$arch_bckp" | sudo tee "$arch_mirr"
    declare -a repos=(archlinux cachyos chaotic)
    sudo pacman-key --init
    for repo in "${repos[@]}"; do
        sudo pacman-key --populate "$repo" && keyrings+=("$repo"-keyring)
    done
    sudo pacman \
        -Syu \
        --noconfirm \
        --disable-download-timeout \
        "${keyrings[@]}"
    sudo grub-mkconfig -o /boot/grub/grub.cfg
}

_PowerOptions() {
    _AskforSnapshot && _Snapshot
    _Installation
    case $1 in
        --no-reboot)
            sed -i '1,$d' {"$arch_list","$aur_list","$arch_aur_list"}
            _PolybarHook
            exit 0
        ;;
        --poweroff) poweroff ;;
        --reboot) reboot ;;
    esac
}

declare -a reboot_criteria=(
    "amd-ucode"
    "grub"
    "linux-cachyos"
    "linux-firmware"
    "linux-zen"
    "linux-znver4"
    "mesa"
    "systemd"
    "xorg-server"
)

_CheckReboot() {

    local restart=0
    for pkg in "${reboot_criteria[@]}"; do
        if grep -qw "${pkg}" "$arch_aur_list"; then
            ((restart++))
        fi
    done

    # the default is reboot.
    # by pressing Enter we will get the default action.
    if (( restart > 0 )); then
        echo -e " ${R}Some critical packages require REBOOT!${N}\n"
        _YesNoPrompt -n " ${R}Poweroff ${N}after updates?" || {
            _YesNoPrompt " ${R}Reboot ${N}after updates?" || {
                unset restart
                _PowerOptions --no-reboot
            }
            _PowerOptions --reboot
        }
        _PowerOptions --poweroff
    else
        echo -e " ${G}NO REBOOT NEEDED!${N}\n"
        # Here the default is 'No Reboot'.
        _YesNoPrompt -n " ${R}Poweroff ${N}after updates?" || {
            _PowerOptions --no-reboot
        }
        _PowerOptions --poweroff
    fi

}

_ListUpdates() {

    mapfile -t aur_updates < "$aur_list"
    mapfile -t arch_updates < "$arch_list"
    mapfile -t total_updates < "$arch_aur_list"

    if (( ${#total_updates[@]} == 0 )); then
        printf '%s\n' " ${R}No available update.${N}"
        read -r -t 3
        return 0
    else
        nl "$arch_aur_list"
        printf '\n%s\n' " ${G}Available update(s): ${#total_updates[@]}${N}"

        _YesNoPrompt " Proceed with installation?" || {
            printf '%s\n' " ${R}bye...${N}"
            read -r -t 2
            return 0
        }

        for update in "${total_updates[@]}"; do
            # shellcheck disable=SC2076
            [[ $update =~ "$cachyos_mirr" || $update =~ "$chaotic_mirr" ]] && {
                printf '%s\n' " ${G}rating $update, please be patient.${N}"
                _rateMirrors third-party
                break
            }
        done

        # first aur_list packages update
        if (( ${#aur_updates[@]} > 0 )); then
            _YesNoPrompt -n " ${R}Are you sure you want to upgrade AUR packages?${N}" || {
                aur_updated=no
                (( ${#arch_updates[@]} > 0 )) && _CheckReboot
            }
            for pkg in "${aur_updates[@]}"; do
                [[ $pkg =~ yay ]] && yay -S yay-bin
            done
            yay -Sua --useask && rm -rf "$HOME"/.ccache
            if (( ${#aur_updates[@]} == ${#total_updates[@]} )); then
                sed -i '1,$d' {"$aur_list","$arch_aur_list"}
                _PolybarHook
                return 0
            fi
        fi

        # then Arch...
        [[ $aur_updated != "no" ]] && (( ${#arch_updates[@]} > 0 )) && _CheckReboot

    fi

}

# In case we want to relaunch _CheckUpdates function,
# or on the session startup.
_CheckForRepoFiles() {

    if [[ -f $arch_aur_list ]]; then
        printf '%s\n' " ${R}${updates-manager##*/} is already running,"
        _YesNoPrompt -n " Restart ${updates-manager##*/}?${N}" || return 1
        rm {"$arch_list","$aur_list","$arch_aur_list"}
        sleep 1
        touch "$arch_aur_list"
        return 0
    else
        touch "$arch_aur_list"
        return 0
    fi

}

# we can check and rate third party repos time to time using --rate third-party.
case $1 in
    --chck) _CheckForRepoFiles && _CheckUpdates ;;
    --hook) _PolybarHook ;;
    --list) _ListUpdates ;;
    --rate) _rateMirrors "$2" ;; # official, third-party
    --snap) _AskforSnapshot && _Snapshot ;;
    --stop) [[ -f $arch_aur_list ]] && _Cleanup ;;
    *     ) _Error "Wrong option: $1" 1 ;;
esac