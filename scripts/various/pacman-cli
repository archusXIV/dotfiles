#!/usr/bin/env bash

# Author: Barret E (2021) <https://github.com/archusXIV/dotfiles>
# Script name: pacman-cli
# License: GPLv2
# Dependencies: awk, fzf, less, reflector, vim, pacman, pacman-contrib.
#
# This script shows a menu to let you choose over severals pacman tools and options.
# In order to install or remove packages it uses fzf utility on the fancy side.
# We can also find and purge orphan packages, refresh our mirrorlist, purge the cache,
# edit pacman.conf/makepkg.conf and of course update the system.
# shellcheck disable=SC2016,SC2145

N=$'\e[0m'
R=$'\e[0;31m'
G=$'\e[0;32m'

if [[ $UID != "0" ]]; then
    echo "${R}You must be root to run this program.${N}" >&2
    exit 1
fi

declare -a dependencies=(
    awk fzf checkupdates less
    reflector vim pacdiff pacman
)

for dep in "${dependencies[@]}"; do
    command -v "$dep" >/dev/null || {
        echo " ${R}Missing dependency...$dep${N}"
        notify-send "pacman-cli: missing dependency...$dep"
        exit 127
    }
done

export FZF_DEFAULT_OPTS="
    --cycle
    --border rounded
    --info=inline-right
    --input-border=rounded
    --input-label ' filter box '
    --input-label-pos=top
    --list-border=rounded
    --list-label-pos=top
    --layout=reverse
    --multi
    --no-scrollbar
    --preview-window='right:70%'
    --pointer '|>'
    --scroll-off=5
"

printf '%s\n' " ${G}Checking for system updates & installed packages...${N}"
declare -a total_updates=()
mapfile -t total_updates < <(checkupdates)
declare -a packages=()
mapfile -t packages < <(pacman -Q)

_Menu() {

    while true; do

        clear
        echo
        printf '%s\n' "                                ${G}Installed packages: ${#packages[@]} - ${R}System updates: ${#total_updates[@]}${N}" \
        "" \
        "                                          ${G}** PACMAN-CLI OPTIONS **" \
        "                        ::To select multiple packages in listing views, press Tab:: " \
        "                       ${R}┌───────────────────────────────────────────────────────────┐" \
        "                       │    ${G}1) ${R}Search & Install           ${G}6) ${R}Update the system     │" \
        "                       │    ${G}2) ${R}Uninstall package(s)       ${G}7) ${R}Run pacdiff           │" \
        "                       │    ${G}3) ${R}List installed packages    ${G}8) ${R}Edit pacman.conf      │" \
        "                       │    ${G}4) ${R}Purge orphans/cache        ${G}9) ${R}Edit makepkg.conf     │" \
        "                       │    ${G}5) ${R}Refresh mirrors            ${G}x) ${R}Exit                  │" \
        "                       └───────────────────────────────────────────────────────────┘" \
        "                                             ${G}Select an item${N}"
        echo

        read -rsn 1 option

        case "$option" in
            1)
                _Install
                packages=()
                mapfile -t packages < <(pacman -Q)
            ;;
            2)
                _Uninstall
                packages=()
                mapfile -t packages < <(pacman -Q)
            ;;
            3) _PackagesList ;;
            4)
                _Purge
                packages=()
                mapfile -t packages < <(pacman -Q)
            ;;
            5) _Reflector ;;
            6)
                _Update
                total_updates=()
                mapfile -t total_updates < <(checkupdates)
                sleep 1
            ;;
            7) _Pacdiff ;;
            8) vim /etc/pacman.conf ;;
            9) vim /etc/makepkg.conf ;;
            x|X)
                clear
                rm "$orphans_list" 2>/dev/null
                export FZF_DEFAULT_OPTS=
                exit
            ;;
            *) echo " ${R}Wrong option: $option${N}"; sleep 2 ;;
        esac

    done
}

_Install() {
    printf '%s\n' " ${G}Initialyzing repositories... please wait.${N}"
    pacman -Sy >/dev/null 2>&1
    pacman -Fy >/dev/null 2>&1
    clear
    pacman -Slq \
        | awk '!seen[$0]++' \
        | fzf \
        --list-label "Install packages" \
        --preview='cat <(pacman -Si {1}) <(pacman -Fl {1} | awk "{print \$2}")' \
        | xargs -ro pacman -Syu --disable-download-timeout
}

_Uninstall() {
    pacman -Qnq \
        | awk '!seen[$0]++' \
        | fzf \
        --list-label "Uninstall packages" \
        --preview='cat <(pacman -Si {1}) <(pacman -Fl {1} | awk "{print \$2}")' \
        | xargs -ro pacman -Rns
}

_PackagesList() {
    pacman -Qq \
        | awk '!seen[$0]++' \
        | fzf \
        --no-multi \
        --list-label "Installed packages" \
        --preview='pacman -Qil {}' \
        --bind 'enter:execute(pacman -Qil {} | less)'
}

_Purge() {
    read -rn 1 -p ' Purge [O]rphans or [C]ache: ' choice
    case "$choice" in
        [oO])
            echo
            local orphans_list="$XDG_CACHE_HOME/orphans.list"
            mapfile -t orphans < <(pacman -Qdtq)

            if (( ${#orphans[@]} )); then
                clear
                touch "$orphans_list"

                declare -a debug_list=()
                for pkg in "${orphans[@]}"; do
                    [[ $pkg =~ -debug ]] && debug_list+=("$pkg")
                    echo "$pkg" >> "$orphans_list"
                done

                awk -i inplace '!seen[$0]++' "$orphans_list"

                if (( ${#debug_list[@]} )); then
                    echo -e "\n ${R}Orphan(s) debug package(s) found.${N}"
                    printf '%s\n' "${debug_list[@]}"
                    echo -e "\n ${R}Certainly needed by:${N}"
                    printf '%s\n' "${debug_list[@]/-debug/}"
                    echo
                    read -rn 1 -p " ${R}Would you like to purge orphan packages? [N/y]:${N}" purge
                else
                    cat "$orphans_list" 2>/dev/null
                    echo
                    read -rn 1 -p " ${R}Would you like to purge orphan packages? [Y/n]:${N}" purge
                fi

                case $purge in
                    [nN])
                        rm "$orphans_list" 2>/dev/null
                    ;;
                    [yY])
                        echo
                        if (( ${#debug_list[@]} )); then
                            printf '%s\n' "${debug_list[@]/-debug/}" | pacman -Rns -
                            printf '%s\n' "${debug_list[@]}" | pacman -Rdd --noconfirm -
                        else
                            pacman -Rns "$(pacman -Qtdq)" --noconfirm
                        fi
                        echo " ${G}Removed packages list saved in $orphans_list.${N}"
                        sleep 5
                    ;;
                    *)  echo " ${R}Bad option $purge...${N}"; sleep 2 ;;
                esac
                rm "$orphans_list" 2>/dev/null
            else
                echo " ${G}No orphan package found.${N}"
                sleep 3
            fi
        ;;
        [cC]) pacman -Scc ;;
        *) printf '\n%s\n' " ${R}Wrong option: ${choice}"; sleep 2 ;;
    esac
}

_Snapshot() {
    local older_snapshot_index older_snapshot_name
    # This will remove the first snapshot & create a new one.
    # awk '/^0/{print $3}' have to match the first snapshot over three.
    older_snapshot_name=$(timeshift --list | awk '/^0/{print $3}')
    older_snapshot_index=$(timeshift --list | awk '/^0/{print $1}')
    # checking if '0' is a string
    if [[ $older_snapshot_index == '0' ]]; then
        timeshift --delete --snapshot "$older_snapshot_name"
        timeshift --create --skip-grub --comment "Before updates $(date)"
    else
        timeshift --create --skip-grub --comment "Before updates $(date)"
    fi
}

_AskForSnapshot() {
    local answer
    printf '\n'
    read -rsn 1 -p " ${R}Do you want to create a snapshot?: [Y/n]${N}" answer
    case $answer in
        [yY])
            if command -v timeshift >/dev/null; then
                return 0
            else
                printf '%s\n' " ${R}Timeshift isn't installed.${N}"
                sleep 2
                return 1
            fi
        ;;
        *) return 1 ;;
    esac
}

_Update() {
    if (( ${#total_updates[@]} )); then
        clear
        _AskForSnapshot && _Snapshot
        printf '\n'
        pacman -Syu
    else
        printf '\n%s\n' " ${G}No updates available.${N}"
        sleep 2
    fi
}

_Pacdiff() {
    if [[ -f $(awk '$7~/\.(pacnew|pacsave)/{last = $7} END {print last}' < /var/log/pacman.log) ]]; then
        pacdiff
    else
        echo " ${G}No pacnew or pacsave files found.${N}"; sleep 2
    fi
}

_Reflector() {
    tput clear
    PS3=""
    echo -e "\n ${G}Select your country:\n Example for France: 21"
    echo -e " More details in a terminal, type: reflector --list-countries | less${N}\n"
    select country in $(reflector --list-countries \
        | sed '1,2d;8d
        s/Hong Kong/Hong-Kong/;s/North Macedonia/North-Macedonia/;
        s/New Caledonia/New-Caledonia/;s/New Zealand/New-Zealand/;
        s/South Africa/South-Africa/;s/South Korea/South-Korea/;
        s/United Arab Emirates/United-Arab-Emirates/;
        s/United States/United-States/;s/United Kingdom/United-Kingdom/' \
        | awk '{print $1}'); do

        case "$country" in
            Hong-Kong) country='Hong Kong' ;;
            New-Caledonia) country='New Caledonia' ;;
            New-Zealand) country='New Zealand' ;;
            North-Macedonia) country='North Macedonia' ;;
            South-Africa) country='South Africa' ;;
            South-Korea) country='South Korea' ;;
            United-Arab-Emirates) country='United Arab Emirates' ;;
            United-Kingdom) country='United Kingdom' ;;
            United-States) country='United States' ;;
        esac

        reflector \
            --country "$country" \
            --verbose \
            --latest 10 \
            --age 24 \
            --protocol https \
            --sort rate \
            --save /etc/pacman.d/mirrorlist
        echo " ${G}New mirrorlist saved.${N}"
        sleep 3
        break
    done
}

_Menu "${@}"

