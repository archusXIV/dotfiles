#!/usr/bin/env bash

# Author: Barret E 2025 <https://github.com/archusXIV>
# Script name: ssr_hidden v2.1.4
# License: GPLv2
#
# Script to run simplescreenrecorder in hidden mode
# for a determined duration & @screen. (see _Usage function)
# My input-profiles directory contains:
# {all_{input,output},left_{input,output},center_{input,output},right_{input,output}}.conf files.
# For example center_output.conf captures the sound from the speakers
# and center_input.conf from the microphone.

red=$'\e[31m';
grn=$'\e[32m';
noc=$'\e[0m';

for dep in pulseaudio simplescreenrecorder; do
    command -v "${dep}" >/dev/null || {
        printf '%s\n' " ${red}$dep isn't installed, exiting.${noc}"
        exit 127
    }
done

trap _Close SIGINT SIGTERM

ssr_fifo="$XDG_RUNTIME_DIR/ssr.fifo"
profiles_path="$XDG_CONFIG_HOME/simplescreenrecorder/input-profiles"

_Usage() {
    printf '%s\n' \
    " Usage:   ${0##*/} -v <volume> -d <duration> -p <profile>" \
    " -b <yes/no>       :Activate polybar mic/volume modules (optional)" \
    " -d <hh:mm:ss>     :Set the video duration" \
    " -l <all>          :List all available input profiles" \
    " -p <profile name> :Set the SimpleScreenRecorder profile to use (omit .conf)" \
    " -t <hh:mm:ss>     :Set a timer before starting the recording" \
    " -v <volume>       :Set the volume for input/output (default:90)" \
    "" \
    " Example: ${0##*/} -v 80 -d 00:15:30 -p profile_name" \
    " or:      ${0##*/} -v 80 -d 15:30 -p profile_name"
    printf '\n%s\n' " Profile(s) should be in $profiles_path" \
    "  ${grn}Audio source(s) currently available:${noc}"
    pactl list sources short | awk '{print "  "$2}'
    [[ -p "$ssr_fifo" ]] && rm "$ssr_fifo"
    exit 1
}

[[ $# -eq 0 || $1 =~ -h|--help ]] && _Usage

[[ -p $ssr_fifo ]] && rm "$ssr_fifo"
mkfifo "$ssr_fifo"

# getting user input according to _Usage function.
while getopts "b:d:l:p:t:v:" opt; do
    case "${opt}" in
        b) bar="${OPTARG}" ;;
        d) duration="${OPTARG}" ;;
        l)
            if ! find "$profiles_path" -name "*.conf" >/dev/null; then
                printf '\n%s\n' " ${red}No profile found in $profiles_path!${noc}"
                exit 1
            else
                printf '\n%s\n' " Available profiles: "
                find "$profiles_path" -name "*.conf" -printf '%f\n' \
                | sort \
                | sed 's/^/ /;s/.conf//'
                exit 0
            fi
        ;;
        p)
            profile="${OPTARG}.conf"
            if ! find "$profiles_path" -name "$profile" >/dev/null; then
                printf '\n%s\n' " ${red}profile $profile does not exist!${noc}"
                _Usage
            fi
        ;;
        t) timer="${OPTARG}" ;;
        v) volume="${OPTARG}%" ;;
        \?)
            echo " ${red}Invalid option -${OPTARG}${noc}" >&2
            exit 1
        ;;
    esac
done

shift $(( OPTIND - 1 ))

[[ -z $duration ]] && {
    printf '\n%s\n' " ${red}Missing duration...${noc}"
    _Usage
}

# default values
: "${bar:=no}"
: "${volume:="90%"}"

[[ -z $profile ]] && {
    printf '\n'
    PS3=""$'\n'" ${grn}Select a source profile: ${noc}"
    select p in $(find "$profiles_path" -type f -printf '%f\n' | sort -d); do
        if [[ -n ${p+x} ]]; then
            profile="$p"
            [[ $profile =~ _output && -z $volume ]] && volume="70%"
            break
        else
            _Usage
        fi
    done
}

_IsPolybarActive() {
    if [[ -n $(pgrep polybar) && $bar == "yes" ]]; then
        return 0
    else
        return 1
    fi
}

_BarActions() {
    pid=$(pgrep -f "$(wmctrl -m | awk '/Name/{print $2}')"-bar-2)
    case "$1" in
        on)
            if [[ $input == "on" ]]; then
                polybar-msg -p "$pid" action "#mic-ipc.hook.1"
                polybar-msg -p "$pid" action "#volume-ipc.hook.0"
            elif [[ $output == "on" ]]; then
                polybar-msg -p "$pid" action "#mic-ipc.hook.0"
                polybar-msg -p "$pid" action "#volume-ipc.hook.1"
            fi
        ;;
        off)
            polybar-msg -p "$pid" action "#mic-ipc.hook.0"
            polybar-msg -p "$pid" action "#volume-ipc.hook.1"
        ;;
    esac

} >/dev/null 2>&1

_GetInputMute() { pactl get-source-mute @DEFAULT_SOURCE@; }
_GetOutputMute() { pactl get-sink-mute @DEFAULT_SINK@; }
_SetInputMute() { pactl set-source-mute @DEFAULT_SOURCE@ "$1"; }
_SetOutputMute() { pactl set-sink-mute @DEFAULT_SINK@ "$1"; }
_SetInputVolume() { pactl set-source-volume @DEFAULT_SOURCE@ "$1"; }
_SetOutputVolume() { pactl set-sink-volume @DEFAULT_SINK@ "$1"; }
# Getting the current volume level so we can restore it when the recording ends
read -r currentvolume < <(
    pactl get-sink-volume @DEFAULT_SINK@ \
    | awk 'NR==1 {print $5}'
)

_SetVolume() {
    case "$1" in
        on)
            if [[ $profile =~ input ]]; then
                # when recording sound from logitech C920,
                # disabling focus_automatic_continuous
                # will prevent clicky sounds to occur.
                command -v v4l2-ctl &> /dev/null && \
                v4l2-ctl --set-ctrl focus_automatic_continuous=0
                _GetInputMute | grep -q 'yes' && _SetInputMute false
                _GetOutputMute | grep -q 'no' && {
                    _SetOutputVolume 0%
                    _SetOutputMute true
                }
                _SetInputVolume "$volume"
                input=on
                _IsPolybarActive && _BarActions on
            elif [[ $profile =~ output ]]; then
                _GetOutputMute | grep -q 'yes' && _SetOutputMute false
                _GetInputMute | grep -q 'no' && {
                    _SetInputVolume 0%
                    _SetInputMute true
                }
                _SetOutputVolume "$volume"
                output=on
                _IsPolybarActive && _BarActions on
            fi
            gsettings set org.gnome.desktop.sound event-sounds false
        ;;
        off)
            if [[ $input == "on" ]]; then
                _SetInputVolume 0%
                _SetInputMute true
                _SetOutputMute false
                _SetOutputVolume "${currentvolume}"
                _IsPolybarActive && _BarActions off
            elif [[ $output == "on" ]]; then
                _SetOutputVolume "${currentvolume}"
                _SetOutputMute false
                _IsPolybarActive && _BarActions off
            fi
            gsettings set org.gnome.desktop.sound event-sounds true
        ;;
    esac
}

_Close() {
    rm "$ssr_fifo"
    _SetVolume off
    reset
    exit 0
}

_TimeConverter() {
    IFS=":";
    if [[ $1  =~ ^[0-9]{2}:[0-9]{2}$ ]]; then
        read -r minutes seconds <<< "$1"
        total_seconds=$(((10#$minutes * 60) + 10#$seconds))
    elif [[ $1  =~ ^[0-9]{2}:[0-9]{2}:[0-9]{2}$ ]]; then
        read -r hours minutes seconds <<< "$1"
        total_seconds=$(((10#$hours * 3600) + (10#$minutes * 60 + 10#$seconds)))
    else
        unset IFS
        printf '\n%s\n' " ${red}Wrong duration syntax...${noc}"
        _Usage
    fi
    unset IFS
}

_Sleep() { read -r -t "$@"; }

[[ -n $timer ]] && {
    _TimeConverter "$timer"
    # Giving a negative number to the seq command because
    # seq only increments but we want to decrement $total_seconds until 0
    for second in $(seq -"$total_seconds" 0); do
        clear
        echo " ${grn}recording will start in: ${second/-/} seconds${noc}"
        _Sleep 1
    done
}

_TimeConverter "$duration"

[[ -n $volume ]] && _SetVolume on

# the output filename and other settings are written in the selected profile
simplescreenrecorder \
    --start-hidden \
    --settingsfile="$profiles_path/$profile" < "$ssr_fifo" &

exec 4> "$ssr_fifo"; _Sleep 0.5
echo "record-start" >&4; _Sleep "$total_seconds"
echo "record-save" >&4; _Sleep 0.5
echo "quit" >&4; exec 4>&-
_Close