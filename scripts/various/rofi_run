#!/usr/bin/env bash

# https://github.com/archusXIV/dotfiles/blob/main/scripts/various/rofi_run

export XDG_CURRENT_DESKTOP=''

NAME=$(basename "$0")

_usage() {
    cat <<- EOF

    USAGE:  $NAME [OPTIONS]

    OPTIONS:
    -h,--help          Display this message
    -l,--logout        System logout dialog
    -r,--run           Application launcher
    -s,--sleep         Put monitor(s) in sleepping modes
    -w,--window        Switch between windows

    Without any options the run dialog will be opened.

EOF
}

for arg in "$@"; do
    case $arg in
        -h) _usage ;;
        -l|--logout)
            if grep -q 'exec startx' "$HOME"/.*profile; then
                answer="$(rofi -normal-window -sep "|" -dmenu -i -p 'System' -width 20 \
                    -hide-scrollbar -line-padding 4 -padding 20 \
                    -lines 3 <<< " Lock| Reboot| Shutdown")"
            else
                WM=$(wmctrl -m | awk '/Name:/{print $NF}')
                answer="$(
                    rofi -normal-window -sep "|" -dmenu -i -p 'Power options' -width 250 \
                    -hide-scrollbar -line-padding  -padding 20 \
                    -lines 6 <<< "   Restart $WM|   Lock|   Exit|   Suspend|   Reboot|   Shutdown"
                )"
            fi
            case "$answer" in
                *Restart) restart_wm restartmsg ;;
                *Lock) scrot_lock ;;
                *Exit) session_exit ;;
                *Suspend) system_suspend --system ;;
                *Reboot) sudo reboot ;;
                *Shutdown) sudo poweroff ;;
            esac
            ;;
        -r|--run)
            rofi -normal-window -modi run,drun -show drun -line-padding 4 \
            -columns 2 -padding 50 -hide-scrollbar
            ;;
        -s|--sleep)
            _setDpmsTimeout() {
                # xset sets all three timeouts at once,
                # so read the current ones first.
                local option="$1" value="$2" line
                local -i standby=0 suspend=0 off=0
                while IFS= read -r line; do
                    if [[ $line =~ Standby:\ *([0-9]+)\ +Suspend:\ *([0-9]+)\ +Off:\ *([0-9]+) ]]; then
                        standby=${BASH_REMATCH[1]}
                        suspend=${BASH_REMATCH[2]}
                        off=${BASH_REMATCH[3]}
                    fi
                done < <(xset q)
                case "$option" in
                    standby) standby=$value ;;
                    suspend) suspend=$value ;;
                    *) off=$value ;;
                esac
                xset +dpms
                sleep 1
                xset dpms "$standby" "$suspend" "$off"
            }
            _setSleepOption() {
                local option="$1"
                answer2="$(
                    rofi -normal-window -sep "|" \
                    -dmenu -i -p "Timeout in minutes before $option" \
                    -width 420 -hide-scrollbar -line-padding  -padding 20 \
                    -lines 2 <<< "   Now|   Disable $option"
                )"
                case "$answer2" in
                    *Now|[0])
                        xfce4-power-manager --quit 2>/dev/null
                        xset +dpms; sleep 1; xset dpms force "$option"
                    ;;
                    *Disable*)
                        xfce4-power-manager --quit 2>/dev/null
                        _setDpmsTimeout "$option" 0
                        notify-send "$option disabled"
                    ;;
                    [0-9]*)
                        # This block catches the user input not the selected item,
                        # for example: 10 (minutes)
                        notify-send "timeout: $answer2 minutes"
                        answer2=$((answer2 * 60))
                        xfce4-power-manager --quit 2>/dev/null
                        _setDpmsTimeout "$option" "$answer2"
                    ;;
                    *) return 1 ;;
                esac
            }
            answer="$(
                rofi -normal-window -sep "|" \
                -dmenu -i -p 'Monitors sleep options' -width 420 \
                -hide-scrollbar -line-padding  -padding 20 \
                -lines 5 <<< "   Enable DPMS|   Standby|   Suspend|   Off|   Disable DPMS"
            )"
            case "$answer" in
                *enable*) xset dpms force on ;;
                *Standby) _setSleepOption standby ;;
                *Suspend) _setSleepOption suspend ;;
                *Off) _setSleepOption off ;;
                *Disable*) xset s off -dpms ;;
            esac
        ;;
        -w|--window)
            rofi -normal-window -modi window -show window -no-show-icons \
            -hide-scrollbar -padding 70 -line-padding 4
            ;;
        *)
            printf "\nOption does not exist: %s\n\n" "$arg"
            exit 2
            ;;
    esac
done

(( $# == 0 )) && "$0" -r

exit 0